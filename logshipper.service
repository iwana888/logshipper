[Unit]
Description=Lightweight log shipper to Loki
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated, unprivileged user that can read the log files.
User=logshipper
Group=logshipper
# Working dir so the relative 'logshipper.ini' is found; or pass an absolute path.
WorkingDirectory=/opt/logshipper
ExecStart=/opt/logshipper/logshipper /opt/logshipper/logshipper.ini
# Stderr is captured by journald (see NFR-3). Recommended log level is INFO.
StandardOutput=journal
StandardError=journal
# Restart on crash, but not on clean SIGTERM (exit 0). 1s backoff.
Restart=on-failure
RestartSec=1
# Clean stop: SIGTERM triggers graceful drain (see NFR-3 / FR-9).
TimeoutStopSec=10
# Hardened defaults (remove if your distro/environment requires more).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/logshipper

[Install]
WantedBy=multi-user.target
